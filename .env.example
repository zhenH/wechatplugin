# ===== 数据库 =====
# 阶段0 用 SQLite 零配置；后续可切换 PostgreSQL: postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./chat.db

# ===== 大模型（DeepSeek 示例，填你的 key 即可）=====
LLM_MODE=openai
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-你的key
LLM_MODEL=deepseek-chat
# 铸造师可用更强的推理模型（可留空，留空则用 LLM_MODEL）
GOD_MODEL=deepseek-reasoner

# ===== 向量化（RAG 用）=====
# 注意：DeepSeek 没有 embedding 接口。默认 auto：配了 EMBED_API_KEY 就走
# 独立 embedding 服务（如 OpenAI、硅基流动等），否则用本地字符向量（离线可用）。
EMBED_MODE=auto
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small

# ===== 访问认证（公网部署防护）=====
# 设置 ACCESS_PASSWORD 后，访问网站需登录；留空则不启用（本地开发）。
ACCESS_PASSWORD=
# token 签名密钥（可选，留空用 ACCESS_PASSWORD）
ACCESS_SECRET=
SESSION_DAYS=7

# ===== 发言算法参数 =====
CONTEXT_N=20
SILENCE_LIMIT=3
DELAY_MIN=2
DELAY_MAX=8
COOLDOWN_MIN=5
COOLDOWN_MAX=180
SUPPRESS_FACTOR=0.45
HIGH_CONC_THRESHOLD=0.7
# 发言概率 P = 话痨度 × (PROB_BASE + PROB_FACTOR×浓度) × 抑制
PROB_BASE=0.4
PROB_FACTOR=2.0

# ===== 浓度混合计算（embedding 粗筛 + LLM 校准）=====
# 粗筛相似度低于 CONC_LOW 直接判低浓度；高于 CONC_HIGH 直接判高浓度；中间才调 LLM 打分
CONC_LOW=0.25
CONC_HIGH=0.75
# 非点名闲聊基线浓度：普通聊天时 agent 参与闲聊的意愿下限（调高更爱接话）
CONC_MIN=0.3
# 防复读相似度阈值：回复与自己的上一条超过此相似度就拦截（0~1，默认 0.8）
REPEAT_THRESHOLD=0.8
